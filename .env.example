# PostgreSQL ma'lumotlar bazasi ulanish manzili
DATABASE_URL=postgresql://postgres:parol@localhost:5432/vision_detect_event_handler

# Google AI Studio dan olingan bepul Gemini API kaliti
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sizning_gemini_api_kalitingiz

# Bepul ishlovchi modellar ro'yxati (navbat bilan ishlaydi)
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.8-flash,gemini-flash-latest

CACHE_ENABLED=true
